# Ghostty renders the terminal. Zellij owns workspace sessions and panes.
# Recovery shell: ghostty -e zsh -l
command = zellij attach --create work
shell-integration = zsh

# ==============================================================================
# THEME AND COLORS
# ==============================================================================

theme = Atom One Dark
background-opacity = 0.98
foreground = #ABB2BF
cursor-color = #D19A66
selection-background = #3E4451
selection-foreground = #FFFFFF

# One Dark action palette: magenta slots intentionally become orange/purple.
palette = 1=#E06C75
palette = 2=#98C379
palette = 3=#E5C07B
palette = 4=#61AFEF
palette = 5=#D19A66
palette = 6=#56B6C2
palette = 9=#E06C75
palette = 10=#98C379
palette = 11=#D19A66
palette = 12=#528BFF
palette = 13=#C678DD
palette = 14=#56B6C2

# ==============================================================================
# FONT
# ==============================================================================

font-family = JetBrainsMono Nerd Font
font-style = Bold
font-style-bold = Bold
font-style-italic = Bold Italic
font-style-bold-italic = Bold Italic
font-size = 13
# JetBrains coding ligatures and a dotted zero improve dense code readability.
font-feature = +calt
font-feature = +liga
font-feature = +zero
# Extra weight without increasing font size or reducing terminal capacity.
font-thicken = true

# ==============================================================================
# WINDOW
# ==============================================================================

window-padding-x = 8
window-padding-y = 6
gtk-titlebar-style = tabs
mouse-hide-while-typing = true

# ==============================================================================
# SECURITY AND BEHAVIOR
# ==============================================================================

clipboard-paste-protection = true
clipboard-read = ask
clipboard-write = allow
copy-on-select = clipboard
confirm-close-surface = false
quit-after-last-window-closed = true
quit-after-last-window-closed-delay = 5m
cursor-style = block
cursor-style-blink = false
window-theme = auto

# ==============================================================================
# KEYBINDINGS
# ==============================================================================

keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+page_down=next_tab
keybind = ctrl+page_up=previous_tab
keybind = ctrl+shift+,=reload_config
