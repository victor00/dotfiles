# Ghostty renders the terminal. Zellij owns workspace sessions and panes.
# Recovery shell: ghostty -e zsh -l
command = zellij attach --create work
shell-integration = zsh

# ==============================================================================
# THEME AND COLORS
# ==============================================================================

theme = One Dark Pro Mix
background-opacity = 0.97

# ==============================================================================
# FONT
# ==============================================================================

font-family = JetBrains Mono
font-size = 13
# Supported by Ghostty where the platform provides font thickening.
font-thicken = true

# ==============================================================================
# WINDOW
# ==============================================================================

window-padding-x = 10
window-padding-y = 8
gtk-titlebar-style = tabs
mouse-hide-while-typing = true

# ==============================================================================
# SECURITY AND BEHAVIOR
# ==============================================================================

clipboard-paste-protection = true
clipboard-read = ask
clipboard-write = allow
copy-on-select = clipboard
confirm-close-surface = false
quit-after-last-window-closed = true
quit-after-last-window-closed-delay = 5m
cursor-style = block
cursor-style-blink = false
window-theme = auto

# ==============================================================================
# KEYBINDINGS
# ==============================================================================

keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+page_down=next_tab
keybind = ctrl+page_up=previous_tab
keybind = ctrl+shift+,=reload_config
