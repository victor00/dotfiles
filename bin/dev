#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: dev project [QUERY]
       dev project --list
       dev find NAME
       dev directory NAME
       dev file NAME
       dev kube [--live|contexts|use CONTEXT]
       dev docs TERM
       dev docs --search TERM
       dev status [SERVICE]
       dev localhost
       dev ports
       dev port PORT
       dev open PORT
       dev --help

project finds Git repositories. find searches files and directories by name;
directory and file restrict the result type. DEV_PROJECT_ROOTS is a colon-separated
list of search roots and defaults to your home directory. Hidden paths are included,
but .git contents are excluded.
EOF
}

die() { printf 'dev: %s\n' "$*" >&2; exit 1; }
require_command() { command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"; }

if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-}" != dumb ]]; then
  readonly GREEN=$'\033[38;2;166;227;161m' BLUE=$'\033[38;2;137;180;250m'
  readonly PEACH=$'\033[38;2;250;179;135m' RED=$'\033[38;2;243;139;168m' RESET=$'\033[0m'
else
  readonly GREEN='' BLUE='' PEACH='' RED='' RESET=''
fi

search_paths() {
  local kind="$1" name="$2" root type_arg=()
  local -a roots
  IFS=: read -r -a roots <<< "${DEV_PROJECT_ROOTS:-$HOME}"

  case "$kind" in
    directory) type_arg=(--type d) ;;
    file) type_arg=(--type f) ;;
  esac

  if command -v fd >/dev/null 2>&1; then
    for root in "${roots[@]}"; do
      [[ -d "$root" ]] || continue
      fd "${type_arg[@]}" --absolute-path --hidden --exclude .git --glob "$name" . "$root" 2>/dev/null || true
    done
  else
    for root in "${roots[@]}"; do
      [[ -d "$root" ]] || continue
      case "$kind" in
        directory) find "$root" -path '*/.git' -prune -o -type d -name "$name" -print 2>/dev/null ;;
        file) find "$root" -path '*/.git' -prune -o -type f -name "$name" -print 2>/dev/null ;;
        any) find "$root" -path '*/.git' -prune -o -name "$name" -print 2>/dev/null ;;
      esac
    done
  fi
}

select_one() {
  local prompt="$1"
  shift
  local -a candidates=("$@")
  ((${#candidates[@]} > 0)) || die 'no match found'
  if ((${#candidates[@]} == 1)); then
    printf '%s\n' "${candidates[0]}"
  elif command -v fzf >/dev/null 2>&1 && [[ -t 0 && -t 1 ]]; then
    printf '%s\n' "${candidates[@]}" | fzf --prompt="$prompt > " --height=60% --layout=reverse --border
  else
    printf 'dev: multiple matches; refine the name:\n' >&2
    printf '  %s\n' "${candidates[@]}" >&2
    exit 1
  fi
}

kube_command() {
  require_command kubectl
  case "${1:-}" in
    "")
      local context namespace cluster server
      context="$(kubectl config current-context 2>/dev/null || true)"
      [[ -n "$context" ]] || die 'no Kubernetes context is configured'
      namespace="$(kubectl config view --minify -o 'jsonpath={..namespace}' 2>/dev/null || true)"
      cluster="$(kubectl config view --minify -o 'jsonpath={.contexts[0].context.cluster}' 2>/dev/null || true)"
      server="$(kubectl config view --minify -o 'jsonpath={.clusters[0].cluster.server}' 2>/dev/null || true)"
      printf '%sKubernetes%s\n  Context:   %s%s%s\n  Namespace: %s\n  Cluster:   %s\n  Server:    %s\n' \
        "$BLUE" "$RESET" "$GREEN" "$context" "$RESET" "${namespace:-default}" \
        "${cluster:-unknown}" "${server:-unknown}"
      printf '\nLocal configuration only. Use %sdev kube --live%s to query the cluster.\n' "$PEACH" "$RESET"
      ;;
    --live)
      [[ $# -eq 1 ]] || { usage >&2; exit 2; }
      kube_command
      printf '\n%sLive cluster summary%s\n' "$BLUE" "$RESET"
      kubectl get nodes --request-timeout=8s
      kubectl get pods --all-namespaces --request-timeout=8s \
        -o custom-columns='NAMESPACE:.metadata.namespace,NAME:.metadata.name,STATUS:.status.phase' \
        --no-headers | awk '{count[$3]++} END {for (status in count) printf "  %-12s %d\n", status, count[status]}'
      ;;
    contexts)
      [[ $# -eq 1 ]] || { usage >&2; exit 2; }
      kubectl config get-contexts
      ;;
    use)
      [[ $# -eq 2 ]] || { usage >&2; exit 2; }
      printf 'Will change the local Kubernetes context to: %s\n' "$2"
      read -r -p 'Continue? [y/N] ' answer
      [[ "$answer" =~ ^[Yy]$ ]] || die 'context change cancelled'
      kubectl config use-context "$2"
      ;;
    -h|--help) usage ;;
    *) die "unknown kube action: $1" ;;
  esac
}

docs_command() {
  [[ $# -gt 0 ]] || { usage >&2; exit 2; }
  if [[ "$1" == --search ]]; then
    shift
    [[ $# -gt 0 ]] || die 'docs --search requires a term'
    require_command apropos
    apropos -- "$*"
    return
  fi
  [[ $# -eq 1 ]] || { usage >&2; exit 2; }
  if command -v man >/dev/null 2>&1 && man -w -- "$1" >/dev/null 2>&1; then
    exec man -- "$1"
  elif command -v tldr >/dev/null 2>&1; then
    exec tldr "$1"
  else
    die "no local manual found for $1; install tldr for practical examples"
  fi
}

status_command() {
  require_command curl
  require_command jq
  local requested="${1:-all}" service url json indicator color status_text failures=0
  [[ $# -le 1 ]] || { usage >&2; exit 2; }
  local -a services=(github cloudflare npm openai docker)
  declare -A urls=(
    [github]='https://www.githubstatus.com/api/v2/status.json'
    [cloudflare]='https://www.cloudflarestatus.com/api/v2/status.json'
    [npm]='https://status.npmjs.org/api/v2/status.json'
    [openai]='https://status.openai.com/api/v2/status.json'
    [docker]='https://www.dockerstatus.com/'
  )
  [[ "$requested" == all ]] || services=("$requested")
  printf '%sService status%s\n' "$BLUE" "$RESET"
  for service in "${services[@]}"; do
    url="${urls[$service]:-}"
    [[ -n "$url" ]] || die "unknown service: $service (use: github, cloudflare, npm, openai, docker)"
    if json="$(curl --fail --silent --show-error --location --connect-timeout 3 --max-time 8 "$url" 2>/dev/null)"; then
      if [[ "$service" == docker ]]; then
        if grep -Fq 'All Systems Operational' <<< "$json"; then
          indicator=none
          status_text='All Systems Operational'
        else
          indicator=minor
          status_text='See official Docker status page'
        fi
      else
        indicator="$(jq -r '.status.indicator // "unknown"' <<< "$json")"
        status_text="$(jq -r '.status.description // "Unknown"' <<< "$json")"
      fi
      case "$indicator" in
        none) color="$GREEN" ;;
        minor|maintenance) color="$PEACH" ;;
        *) color="$RED" ;;
      esac
      printf '  %-12s %s%s%s\n' "$service" "$color" "$status_text" "$RESET"
    else
      printf '  %-12s %sunavailable%s\n' "$service" "$RED" "$RESET"
      failures=$((failures + 1))
    fi
  done
  ((failures == 0))
}

ports_command() {
  require_command ss
  local socket_lines line local_address port process
  declare -A seen_ports=()
  socket_lines="$(ss -H -ltnp)" || die 'cannot inspect local listening ports'
  printf '%sLocal listening ports%s\n' "$BLUE" "$RESET"
  printf '  %-8s %-24s %s\n' PORT ENDPOINT PROCESS
  while IFS= read -r line; do
    local_address="$(awk '{print $4}' <<< "$line")"
    port="${local_address##*:}"
    [[ "$port" =~ ^[0-9]+$ ]] || continue
    [[ -z "${seen_ports[$port]:-}" ]] || continue
    seen_ports[$port]=1
    process="$(sed -n 's/.*users:(("\([^"]*\)".*/\1/p' <<< "$line")"
    printf '  %-8s %-24s %s\n' "$port" "localhost:$port" "${process:-unknown}"
  done <<< "$socket_lines"
}

command_name="${1:-}"
case "$command_name" in
  -h|--help) usage; exit 0 ;;
  kube) shift; kube_command "$@" ;;
  docs) shift; docs_command "$@" ;;
  status) shift; status_command "$@" ;;
  localhost|ports)
    shift
    [[ $# -eq 0 ]] || { usage >&2; exit 2; }
    ports_command
    ;;
  port)
    shift
    [[ $# -eq 1 && "$1" =~ ^[0-9]+$ && "$1" -le 65535 ]] || { usage >&2; exit 2; }
    require_command ss
    ss -ltnp "sport = :$1"
    ;;
  open)
    shift
    [[ $# -eq 1 && "$1" =~ ^[0-9]+$ && "$1" -le 65535 ]] || { usage >&2; exit 2; }
    require_command xdg-open
    require_command ss
    ss -H -ltn "sport = :$1" | grep -q . || die "no local TCP listener found on port: $1"
    nohup xdg-open "http://localhost:$1" >/dev/null 2>&1 &
    printf 'Opening %shttp://localhost:%s%s\n' "$GREEN" "$1" "$RESET"
    ;;
  project)
    shift
    mode=select
    query=""
    case "${1:-}" in
      --list) mode=list; shift ;;
      -h|--help) usage; exit 0 ;;
      "") ;;
      --*) printf 'dev project: unknown option: %s\n' "$1" >&2; exit 2 ;;
      *) query="$1"; shift ;;
    esac
    [[ $# -eq 0 ]] || { usage >&2; exit 2; }

    IFS=: read -r -a roots <<< "${DEV_PROJECT_ROOTS:-$HOME}"
    projects=()
    for root in "${roots[@]}"; do
      [[ -d "$root" ]] || continue
      while IFS= read -r -d '' git_dir; do projects+=("${git_dir%/.git}"); done \
        < <(find "$root" -mindepth 2 -maxdepth 5 \
          -type d -name .git -print0 -prune -o -path '*/.*' -prune 2>/dev/null)
    done
    ((${#projects[@]} > 0)) || die 'no Git projects found; configure DEV_PROJECT_ROOTS'
    mapfile -t projects < <(printf '%s\n' "${projects[@]}" | LC_ALL=C sort -u)
    [[ "$mode" == list ]] && { printf '%s\n' "${projects[@]}"; exit 0; }
    if [[ -n "$query" ]]; then
      mapfile -t matches < <(printf '%s\n' "${projects[@]}" | grep -iF -- "$query" || true)
      select_one project "${matches[@]}"
    else
      select_one project "${projects[@]}"
    fi
    ;;
  find|directory|file)
    shift
    [[ "${1:-}" == -h || "${1:-}" == --help ]] && { usage; exit 0; }
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    mapfile -t matches < <(search_paths "${command_name/find/any}" "$1" | LC_ALL=C sort -u)
    ((${#matches[@]} > 0)) || die "no match found: $1"
    printf '%s\n' "${matches[@]}"
    ;;
  *) usage >&2; exit 2 ;;
esac
