#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: git recent [LIMIT]

List recently updated local branches. LIMIT defaults to 15.
EOF
}

case "${1:-}" in -h|--help) usage; exit 0 ;; esac
limit="${1:-15}"
[[ $# -le 1 && "$limit" =~ ^[1-9][0-9]*$ ]] || { usage >&2; exit 2; }

root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  printf 'git recent: not inside a Git repository\n' >&2
  exit 1
}
git -C "$root" for-each-ref \
  --sort=-committerdate \
  --count="$limit" \
  --format='%(HEAD) %(refname:short)  %(committerdate:relative)  %(subject)' \
  refs/heads/
